{
  "name": "hello-pet",
  "version": "0.2.8",
  "private": true,
  "author": "Dongdong",
  "description": "A little desktop companion for two computers on Tailscale",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "preview": "node scripts/preview.cjs",
    "test": "node --test tests/*.test.cjs",
    "assets": "node scripts/make-icon.cjs",
    "dist:mac": "npm run assets && node scripts/build-mac.cjs",
    "dist:win": "npm run assets && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "lucide-static": "^1.48.0",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "io.hellopet.desktop",
    "productName": "Dongdong",
    "icon": "assets/icon.png",
    "asar": true,
    "files": ["electron/**/*", "public/**/*", "server/**/*", "assets/icon.png", "package.json"],
    "directories": { "output": "release" },
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "assets/icon.icns",
      "target": ["dmg"],
      "artifactName": "Dongdong-${version}-${arch}.dmg"
    },
    "win": { "target": ["nsis"], "icon": "assets/icon.ico" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Dongdong-${version}-Setup.${ext}"
    }
  }
}
